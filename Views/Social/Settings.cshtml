@{
    Layout = "_SocialLayoutModern";
    ViewData["Title"] = "Ayarlar";
    var u = ViewBag.ProfileUser;
    string adSoyad = u?.AdSoyad ?? User.Identity?.Name ?? "Kullanıcı";
    string email = u?.Email ?? "";
    string bio = u?.Biyografi ?? "";
    string avatar = string.IsNullOrWhiteSpace((string)(u?.ProfilResmi ?? ""))
        ? "https://ui-avatars.com/api/?name=" + Uri.EscapeDataString(adSoyad) + "&background=random&size=256"
        : (string)u.ProfilResmi;
    string tema = string.IsNullOrWhiteSpace((string)(u?.ProfilTema ?? "")) ? "#c6ff00" : (string)u.ProfilTema;
    bool ikiFaktor = u?.IkiFactorAktif != null && (bool)u.IkiFactorAktif;
}

<header class="sticky top-0 z-30 flex h-14 md:h-16 items-center justify-between border-b border-border bg-background/95 px-3 md:px-6 backdrop-blur">
    <h1 class="text-lg md:text-xl font-bold">Ayarlar</h1>
</header>

<div class="mx-auto max-w-5xl p-3 md:p-6 pb-24">
    <section class="overflow-hidden rounded-2xl border border-border/60 bg-card p-4 shadow-sm md:p-6">
        <div class="flex flex-col gap-5 sm:flex-row sm:items-center">
            <label class="group relative block h-24 w-24 shrink-0 cursor-pointer overflow-hidden rounded-2xl bg-secondary ring-4 ring-background">
                <img id="profilePreview" src="@avatar" class="h-full w-full object-cover" alt="Profil" />
                <span class="absolute inset-0 flex items-center justify-center bg-black/55 opacity-0 transition group-hover:opacity-100"><i data-lucide="camera" class="h-7 w-7 text-white"></i></span>
                <input id="profilResmi" form="profileForm" name="profilResmi" type="file" accept="image/png,image/jpeg,image/gif,image/webp" class="hidden" onchange="previewProfileImage()" />
            </label>
            <div class="min-w-0 flex-1">
                <p class="text-[11px] font-bold uppercase tracking-widest text-muted-foreground">Hesap merkezi</p>
                <h2 class="truncate text-2xl font-black">@adSoyad</h2>
                <p class="mt-1 truncate text-sm font-semibold text-primary">@email</p>
                <p class="mt-2 max-w-2xl text-sm leading-6 text-muted-foreground">Profil, görünüm, bildirim ve güvenlik tercihlerini buradan yönet.</p>
            </div>
            <a href="/Social/Profil/me" class="inline-flex items-center justify-center gap-2 rounded-xl bg-secondary px-5 py-3 text-sm font-bold transition hover:bg-secondary/80">
                <i data-lucide="external-link" class="h-4 w-4"></i> Profili Gör
            </a>
        </div>
    </section>

    <div class="mt-6 grid gap-6 md:grid-cols-[230px_minmax(0,1fr)]">
        <aside class="space-y-1 md:sticky md:top-24 md:self-start">
            <button onclick="switchSettingsTab('account')" id="nav-account" class="settings-nav active"><i data-lucide="user" class="h-5 w-5"></i> Hesap</button>
            <button onclick="switchSettingsTab('appearance')" id="nav-appearance" class="settings-nav"><i data-lucide="palette" class="h-5 w-5"></i> Görünüm</button>
            <button onclick="switchSettingsTab('notifications')" id="nav-notifications" class="settings-nav"><i data-lucide="bell" class="h-5 w-5"></i> Bildirimler</button>
            <button onclick="switchSettingsTab('privacy')" id="nav-privacy" class="settings-nav"><i data-lucide="shield" class="h-5 w-5"></i> Güvenlik</button>
            <div class="border-t border-border/60 pt-3">
                <button onclick="logout()" class="flex w-full items-center gap-3 rounded-xl px-4 py-3 text-sm font-bold text-destructive transition hover:bg-destructive/10"><i data-lucide="log-out" class="h-5 w-5"></i> Çıkış Yap</button>
            </div>
        </aside>

        <main class="min-w-0 space-y-6">
            <section id="tab-account" class="settings-tab space-y-6">
                <form id="profileForm" onsubmit="saveProfile(event)" class="rounded-2xl border border-border/60 bg-card p-5 md:p-6">
                    @Html.AntiForgeryToken()
                    <div class="mb-5 flex items-center gap-2"><i data-lucide="user-circle" class="h-5 w-5 text-primary"></i><h3 class="text-lg font-black">Temel Bilgiler</h3></div>
                    <div class="grid gap-4 sm:grid-cols-2">
                        <label class="block"><span class="settings-label">Tam Ad</span><input name="adSoyad" value="@adSoyad" class="settings-input" maxlength="100" required /></label>
                        <label class="block"><span class="settings-label">E-posta</span><input value="@email" class="settings-input opacity-70" readonly /></label>
                        <label class="block sm:col-span-2"><span class="settings-label">Biyografi</span><textarea name="biyografi" rows="4" maxlength="500" class="settings-input resize-none" placeholder="Kendinden ve tasarım tarzından bahset...">@bio</textarea></label>
                        <label class="block"><span class="settings-label">Profil Rengi</span><input id="profilTema" name="profilTema" type="color" value="@tema" class="h-12 w-full rounded-xl border border-border bg-secondary p-1" /></label>
                    </div>
                    <div class="mt-5 flex justify-end"><button id="profileSaveBtn" class="rounded-xl bg-primary px-6 py-3 text-sm font-bold text-primary-foreground shadow-lg shadow-primary/20">Değişiklikleri Kaydet</button></div>
                </form>
            </section>

            <section id="tab-appearance" class="settings-tab hidden space-y-6">
                <div class="rounded-2xl border border-border/60 bg-card p-5 md:p-6">
                    <div class="mb-5 flex items-center gap-2"><i data-lucide="palette" class="h-5 w-5 text-primary"></i><h3 class="text-lg font-black">Tema Tercihi</h3></div>
                    <div class="grid gap-3 sm:grid-cols-3">
                        <button type="button" onclick="setTheme('dark')" id="theme-dark" class="theme-card"><i data-lucide="moon" class="h-5 w-5"></i><span>Karanlık</span></button>
                        <button type="button" onclick="setTheme('light')" id="theme-light" class="theme-card"><i data-lucide="sun" class="h-5 w-5"></i><span>Aydınlık</span></button>
                        <button type="button" onclick="setTheme('system')" id="theme-system" class="theme-card"><i data-lucide="monitor" class="h-5 w-5"></i><span>Sistem</span></button>
                    </div>
                </div>
            </section>

            <section id="tab-notifications" class="settings-tab hidden space-y-6">
                <div class="rounded-2xl border border-border/60 bg-card p-5 md:p-6">
                    <div class="mb-5 flex items-center gap-2"><i data-lucide="bell" class="h-5 w-5 text-primary"></i><h3 class="text-lg font-black">Bildirimler</h3></div>
                    <div class="space-y-3" id="notificationPrefs">
                        <label class="pref-row"><span><b>Beğeniler</b><small>Tasarımların beğenildiğinde haber ver.</small></span><input type="checkbox" data-pref="likes" checked onchange="saveNotificationPrefs()" /></label>
                        <label class="pref-row"><span><b>Yorumlar</b><small>Yorum ve yanıt bildirimlerini göster.</small></span><input type="checkbox" data-pref="comments" checked onchange="saveNotificationPrefs()" /></label>
                        <label class="pref-row"><span><b>Mesajlar</b><small>Yeni direkt mesajları kaçırma.</small></span><input type="checkbox" data-pref="messages" checked onchange="saveNotificationPrefs()" /></label>
                        <label class="pref-row"><span><b>Düello ve yarışmalar</b><small>Oy, davet ve sonuç bildirimleri.</small></span><input type="checkbox" data-pref="duels" checked onchange="saveNotificationPrefs()" /></label>
                    </div>
                </div>
            </section>

            <section id="tab-privacy" class="settings-tab hidden space-y-6">
                <form onsubmit="changePassword(event)" class="rounded-2xl border border-border/60 bg-card p-5 md:p-6">
                    <div class="mb-5 flex items-center gap-2"><i data-lucide="key" class="h-5 w-5 text-primary"></i><h3 class="text-lg font-black">Şifre Değiştir</h3></div>
                    <div class="grid gap-4 sm:grid-cols-2">
                        <input id="mevcutSifre" type="password" class="settings-input" placeholder="Mevcut şifre" autocomplete="current-password" />
                        <input id="yeniSifre" type="password" class="settings-input" placeholder="Yeni şifre (min 6 karakter)" autocomplete="new-password" />
                    </div>
                    <div class="mt-5 flex justify-end"><button class="rounded-xl bg-secondary px-6 py-3 text-sm font-bold transition hover:bg-secondary/80">Şifreyi Güncelle</button></div>
                </form>

                <div class="rounded-2xl border border-border/60 bg-card p-5 md:p-6">
                    <div class="flex items-start justify-between gap-4">
                        <div><div class="mb-2 flex items-center gap-2"><i data-lucide="shield-check" class="h-5 w-5 text-primary"></i><h3 class="text-lg font-black">İki Faktörlü Doğrulama</h3></div><p class="text-sm text-muted-foreground">Giriş sırasında e-posta doğrulama kodu iste.</p></div>
                        <label class="relative inline-flex cursor-pointer items-center"><input id="twoFactorToggle" type="checkbox" class="peer sr-only" @(ikiFaktor ? "checked" : "") onchange="toggle2FA(this)" /><span class="h-7 w-12 rounded-full bg-secondary after:absolute after:left-1 after:top-1 after:h-5 after:w-5 after:rounded-full after:bg-white after:transition peer-checked:bg-primary peer-checked:after:translate-x-5"></span></label>
                    </div>
                </div>

                <div class="rounded-2xl border border-destructive/30 bg-destructive/5 p-5 md:p-6">
                    <div class="flex items-start gap-3"><i data-lucide="trash-2" class="mt-1 h-5 w-5 text-destructive"></i><div><h3 class="font-black text-destructive">Hesabı Sil</h3><p class="mt-1 text-sm text-muted-foreground">Sunum için güvenli modda: bu buton aktif silme yapmaz, kullanıcıyı yanlışlıkla veri kaybından korur.</p></div></div>
                </div>
            </section>
        </main>
    </div>
</div>

<div id="settingsToast" class="fixed bottom-5 left-1/2 z-[80] hidden -translate-x-1/2 rounded-xl bg-foreground px-5 py-3 text-sm font-bold text-background shadow-2xl"></div>

<style>
    .settings-nav { display:flex; width:100%; align-items:center; gap:.75rem; border-radius:.75rem; padding:.75rem 1rem; font-size:.875rem; font-weight:800; color:hsl(var(--muted-foreground)); transition:.2s; }
    .settings-nav:hover { background:hsl(var(--secondary)); color:hsl(var(--foreground)); }
    .settings-nav.active { background:hsl(var(--primary) / .12); color:hsl(var(--primary)); }
    .settings-label { display:block; margin-bottom:.5rem; font-size:.7rem; font-weight:900; letter-spacing:.08em; text-transform:uppercase; color:hsl(var(--muted-foreground)); }
    .settings-input { width:100%; border-radius:.75rem; border:1px solid hsl(var(--border)); background:hsl(var(--secondary) / .45); padding:.8rem 1rem; font-size:.9rem; outline:none; transition:.2s; }
    .settings-input:focus { border-color:hsl(var(--primary)); box-shadow:0 0 0 4px hsl(var(--primary) / .1); }
    .theme-card { display:flex; min-height:7rem; flex-direction:column; align-items:center; justify-content:center; gap:.75rem; border-radius:1rem; border:2px solid hsl(var(--border)); background:hsl(var(--secondary) / .35); font-weight:900; transition:.2s; }
    .theme-card.active { border-color:hsl(var(--primary)); color:hsl(var(--primary)); box-shadow:0 0 0 4px hsl(var(--primary) / .08); }
    .pref-row { display:flex; align-items:center; justify-content:space-between; gap:1rem; border-radius:1rem; background:hsl(var(--secondary) / .35); padding:1rem; }
    .pref-row small { display:block; margin-top:.25rem; color:hsl(var(--muted-foreground)); }
    .pref-row input { height:1.15rem; width:1.15rem; accent-color:hsl(var(--primary)); }
</style>

@section Scripts {
<script>
    function token() { return document.querySelector('input[name="__RequestVerificationToken"]')?.value || ''; }
    function toast(message) {
        var el = document.getElementById('settingsToast');
        el.textContent = message || 'İşlem tamamlandı.';
        el.classList.remove('hidden');
        setTimeout(function(){ el.classList.add('hidden'); }, 2600);
    }
    function switchSettingsTab(tab) {
        document.querySelectorAll('.settings-tab').forEach(function(el){ el.classList.add('hidden'); });
        document.getElementById('tab-' + tab)?.classList.remove('hidden');
        document.querySelectorAll('.settings-nav').forEach(function(el){ el.classList.remove('active'); });
        document.getElementById('nav-' + tab)?.classList.add('active');
        if (window.lucide) lucide.createIcons();
    }
    function previewProfileImage() {
        var file = document.getElementById('profilResmi').files?.[0];
        if (!file) return;
        document.getElementById('profilePreview').src = URL.createObjectURL(file);
    }
    function saveProfile(e) {
        e.preventDefault();
        var btn = document.getElementById('profileSaveBtn');
        var fd = new FormData(document.getElementById('profileForm'));
        fd.append('__RequestVerificationToken', token());
        btn.disabled = true;
        fetch('/Social/AyarlarGuncelle', { method:'POST', credentials:'same-origin', headers:{ 'RequestVerificationToken': token() }, body: fd })
            .then(function(r){ return r.json(); })
            .then(function(data){ toast(data.message || (data.success ? 'Kaydedildi.' : 'Kaydedilemedi.')); })
            .catch(function(){ toast('Bağlantı hatası oluştu.'); })
            .finally(function(){ btn.disabled = false; });
    }
    function setTheme(theme) {
        localStorage.setItem('kartist-theme-mode', theme);
        document.querySelectorAll('.theme-card').forEach(function(el){ el.classList.remove('active'); });
        document.getElementById('theme-' + theme)?.classList.add('active');
        var dark = theme === 'dark' || (theme === 'system' && window.matchMedia('(prefers-color-scheme: dark)').matches);
        document.documentElement.classList.toggle('dark', dark);
        toast('Tema tercihi kaydedildi.');
    }
    function saveNotificationPrefs() {
        var prefs = {};
        document.querySelectorAll('[data-pref]').forEach(function(el){ prefs[el.dataset.pref] = el.checked; });
        localStorage.setItem('kartist-notification-prefs', JSON.stringify(prefs));
        toast('Bildirim tercihleri kaydedildi.');
    }
    function loadNotificationPrefs() {
        try {
            var prefs = JSON.parse(localStorage.getItem('kartist-notification-prefs') || '{}');
            document.querySelectorAll('[data-pref]').forEach(function(el){ if (prefs[el.dataset.pref] !== undefined) el.checked = !!prefs[el.dataset.pref]; });
        } catch {}
    }
    function changePassword(e) {
        e.preventDefault();
        var fd = new FormData();
        fd.append('mevcutSifre', document.getElementById('mevcutSifre').value);
        fd.append('yeniSifre', document.getElementById('yeniSifre').value);
        fd.append('__RequestVerificationToken', token());
        fetch('/Social/AyarSifreDegistir', { method:'POST', credentials:'same-origin', headers:{ 'RequestVerificationToken': token() }, body: fd })
            .then(function(r){ return r.json(); })
            .then(function(data){ toast(data.message || 'İşlem tamamlandı.'); if(data.success){ document.getElementById('mevcutSifre').value=''; document.getElementById('yeniSifre').value=''; } })
            .catch(function(){ toast('Şifre güncellenemedi.'); });
    }
    function toggle2FA(el) {
        var fd = new FormData();
        fd.append('aktif', el.checked);
        fd.append('__RequestVerificationToken', token());
        if (!el.checked) {
            var pass = prompt('2FA kapatmak için mevcut şifreni gir:');
            if (!pass) { el.checked = true; return; }
            fd.append('mevcutSifre', pass);
        }
        fetch('/Social/AyarIkiFactor', { method:'POST', credentials:'same-origin', headers:{ 'RequestVerificationToken': token() }, body: fd })
            .then(function(r){ return r.json(); })
            .then(function(data){ toast(data.message || 'İşlem tamamlandı.'); if(!data.success) el.checked = !el.checked; })
            .catch(function(){ toast('2FA ayarı güncellenemedi.'); el.checked = !el.checked; });
    }
    function logout() {
        if (confirm('Çıkış yapmak istiyor musun?')) window.location.href = '/Account/Cikis';
    }
    document.addEventListener('DOMContentLoaded', function(){
        loadNotificationPrefs();
        setTheme(localStorage.getItem('kartist-theme-mode') || 'dark');
        if (window.lucide) lucide.createIcons();
    });
</script>
}
