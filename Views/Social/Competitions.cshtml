@{
    Layout = "_SocialLayoutModern";
    ViewData["Title"] = "Yarışmalar";
}

<!-- Header -->
<header class="sticky top-0 z-30 flex h-14 md:h-16 items-center justify-between border-b border-border bg-background/95 px-3 md:px-6 backdrop-blur">
    <div class="flex items-center gap-3 md:gap-4">
        <h1 class="text-lg md:text-xl font-bold">Yarışmalar</h1>
    </div>
</header>

<div class="p-3 md:p-6 text-foreground bg-background">
    <!-- Hero Section -->
    <div class="rounded-2xl md:rounded-3xl bg-gradient-to-r from-yellow-500/20 via-amber-500/20 to-orange-500/20 p-4 md:p-8 relative overflow-hidden border border-yellow-500/10">
        <div class="absolute -right-20 -top-20 h-64 w-64 rounded-full bg-yellow-500/20 blur-3xl"></div>
        <div class="absolute -left-20 -bottom-20 h-64 w-64 rounded-full bg-orange-500/20 blur-3xl"></div>
        
        <div class="relative z-10 flex flex-col md:flex-row md:items-center justify-between gap-4 md:gap-6">
            <div class="flex items-center gap-3 md:gap-4">
                <div class="flex h-12 w-12 md:h-16 md:w-16 items-center justify-center rounded-xl md:rounded-2xl bg-gradient-to-br from-yellow-500 to-amber-500 shadow-xl shadow-yellow-500/20 shrink-0">
                    <i data-lucide="trophy" class="h-6 w-6 md:h-8 md:w-8 text-white"></i>
                </div>
                <div>
                    <h1 class="text-xl md:text-3xl font-bold">Tasarım Yarışmaları</h1>
                    <p class="text-muted-foreground text-sm md:text-base mt-0.5 md:mt-1">Yarışmaya katıl, yeteneğini sergile, ödüller kazan!</p>
                </div>
            </div>
            
            <button class="flex items-center justify-center gap-2 rounded-xl bg-primary px-5 md:px-6 py-2.5 md:py-3 font-semibold text-primary-foreground transition-all hover:opacity-90 gold-glow whitespace-nowrap text-sm md:text-base">
                <i data-lucide="sparkles" class="h-4 w-4 md:h-5 md:w-5"></i>
                Nasil Calisir?
            </button>
        </div>

        <!-- Stats -->
        <div class="mt-4 md:mt-8 grid grid-cols-2 lg:grid-cols-4 gap-3 md:gap-6 relative z-10">
            <div class="glass-card rounded-xl p-5 border-white/5">
                <div class="flex items-center gap-2 text-muted-foreground mb-2">
                    <i data-lucide="target" class="h-4 w-4 text-yellow-500"></i>
                    <span class="text-sm font-medium">Aktif Yarışma</span>
                </div>
                <p class="text-3xl font-bold">@(ViewBag.ActiveCompetitions ?? 2)</p>
            </div>
            <div class="glass-card rounded-xl p-5 border-white/5">
                <div class="flex items-center gap-2 text-muted-foreground mb-2">
                    <i data-lucide="users" class="h-4 w-4"></i>
                    <span class="text-sm font-medium">Toplam Katilimci</span>
                </div>
                <p class="text-3xl font-bold">@(ViewBag.TotalParticipants ?? 323)</p>
            </div>
            <div class="glass-card rounded-xl p-5 border-white/5">
                <div class="flex items-center gap-2 text-muted-foreground mb-2">
                    <i data-lucide="award" class="h-4 w-4"></i>
                    <span class="text-sm font-medium">Toplam Odul</span>
                </div>
                <p class="text-3xl font-bold text-accent">30<span class="text-xl">k TL</span></p>
            </div>
            <div class="glass-card rounded-xl p-5 border-white/5">
                <div class="flex items-center gap-2 text-muted-foreground mb-2">
                    <i data-lucide="medal" class="h-4 w-4"></i>
                    <span class="text-sm font-medium">Bu Ay Kazananlar</span>
                </div>
                <p class="text-3xl font-bold text-primary">@(ViewBag.MonthlyWinners ?? 0)</p>
            </div>
        </div>
    </div>

    <!-- Filters -->
    <div class="mt-8 flex flex-wrap gap-2" id="compFilters">
        <button onclick="filterComps('all')" id="comp-all" class="rounded-xl px-6 py-2.5 text-sm font-bold transition-all bg-primary text-primary-foreground gold-glow">
            <i data-lucide="grid" class="h-4 w-4 inline-block mr-1"></i> Tumu
        </button>
        <button onclick="filterComps('active')" id="comp-active" class="rounded-xl px-6 py-2.5 text-sm font-bold transition-all bg-secondary text-secondary-foreground hover:bg-secondary/80">
            <i data-lucide="zap" class="h-4 w-4 inline-block mr-1"></i> Aktif
        </button>
        <button onclick="filterComps('voting')" id="comp-voting" class="rounded-xl px-6 py-2.5 text-sm font-bold transition-all bg-secondary text-secondary-foreground hover:bg-secondary/80">
            <i data-lucide="bar-chart-2" class="h-4 w-4 inline-block mr-1"></i> Oylama
        </button>
        <button onclick="filterComps('ended')" id="comp-ended" class="rounded-xl px-6 py-2.5 text-sm font-bold transition-all bg-secondary text-secondary-foreground hover:bg-secondary/80">
            <i data-lucide="check-circle" class="h-4 w-4 inline-block mr-1"></i> Tamamlanan
        </button>
    </div>

    <!-- Competitions Grid -->
    <div class="mt-8 grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6" id="competitionsGrid">
        @if (ViewBag.Competitions != null)
        {
            foreach (var comp in ViewBag.Competitions)
            {
                var isVoting = comp.Status == "voting";
                var isEnded = comp.Status == "ended";
                var joined = (comp.Joined ?? 0) == 1;
                <div class="group relative overflow-hidden rounded-2xl glass-card transition-all hover:-translate-y-1 hover:shadow-xl hover:border-primary/50 flex flex-col" data-status="@comp.Status">
                    <div class="relative aspect-[16/9] overflow-hidden shrink-0">
                        <img src="@(comp.CoverImage)" class="h-full w-full object-cover transition-transform duration-700 group-hover:scale-105" />
                        <div class="absolute inset-0 bg-gradient-to-t from-black via-black/40 to-transparent"></div>
                        
                        <!-- Status Badge -->
                        <div class="absolute left-4 top-4">
                            @if(isVoting) {
                                <div class="flex items-center gap-1.5 rounded-full bg-accent px-3 py-1.5 text-xs font-bold text-accent-foreground shadow-lg shadow-accent/20">
                                    <span class="relative flex h-2 w-2">
                                        <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-white opacity-75"></span>
                                        <span class="relative inline-flex h-2 w-2 rounded-full bg-white"></span>
                                    </span>
                                    OYLAMA
                                </div>
                            } else if (isEnded) {
                                <div class="flex items-center gap-1.5 rounded-full bg-secondary px-3 py-1.5 text-xs font-bold shadow-lg">
                                    <i data-lucide="check-circle" class="h-3 w-3"></i>
                                    TAMAMLANDI
                                </div>
                            } else {
                                <div class="flex items-center gap-1.5 rounded-full bg-primary px-3 py-1.5 text-xs font-bold text-primary-foreground shadow-lg shadow-primary/20">
                                    <span class="relative flex h-2 w-2">
                                        <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-card opacity-75"></span>
                                        <span class="relative inline-flex h-2 w-2 rounded-full bg-card"></span>
                                    </span>
                                    AKTIF
                                </div>
                            }
                        </div>
                        
                        <!-- Theme & Title -->
                        <div class="absolute bottom-0 left-0 right-0 p-5 translate-y-2 opacity-90 transition-all duration-300 group-hover:translate-y-0 group-hover:opacity-100">
                            <span class="rounded-full bg-white/20 px-3 py-1 text-xs font-semibold text-white backdrop-blur-md mb-2 inline-block shadow-sm">@(comp.Theme)</span>
                            <h3 class="text-xl font-bold text-white line-clamp-2">@(comp.Title)</h3>
                        </div>
                    </div>
                    
                    <div class="p-5 flex flex-col flex-1 bg-card">
                        <div class="flex items-center justify-between mb-6">
                            <div>
                                <p class="text-xs text-muted-foreground font-medium mb-1">Odul Havuzu</p>
                                <p class="font-bold text-primary text-lg flex items-center gap-1">
                                    <i data-lucide="coins" class="h-4 w-4"></i> @(comp.Prize)
                                </p>
                            </div>
                            <div class="text-right">
                                <p class="text-xs text-muted-foreground font-medium mb-1">Katilimci</p>
                                <p class="font-bold text-lg flex items-center gap-1 justify-end">
                                    <i data-lucide="users" class="h-4 w-4 text-muted-foreground"></i> @(comp.Participants)
                                </p>
                            </div>
                        </div>
                        
                        <div class="mt-auto pt-4 border-t border-border/50 flex flex-col gap-4">
                            @if(!isEnded) {
                                <div class="flex items-center justify-between">
                                    <div class="flex items-center gap-2 text-sm font-medium @(isVoting ? "text-accent" : "text-muted-foreground")">
                                        <i data-lucide="clock" class="h-4 w-4"></i>
                                        <span>@(comp.Deadline) @(isVoting ? "sonuc" : "kaldi")</span>
                                    </div>
                                    <div class="flex -space-x-2">
                                        <img src="https://ui-avatars.com/api/?name=A&background=random" class="h-6 w-6 rounded-full border border-card" />
                                        <img src="https://ui-avatars.com/api/?name=B&background=random" class="h-6 w-6 rounded-full border border-card" />
                                        <div class="flex h-6 w-6 items-center justify-center rounded-full border border-card bg-secondary text-[8px] font-bold">+@comp.Participants</div>
                                    </div>
                                </div>
                            }
                            
                            @if (!isVoting && !isEnded && !joined)
                            {
                                <a href='/Home/Tasarim?id=0&yarismaId=@comp.Id' class="w-full rounded-xl py-3 text-sm font-bold transition-all flex items-center justify-center gap-2 bg-gradient-to-r from-primary via-yellow-400 to-primary text-primary-foreground hover:opacity-90 neon-glow">
                                    <i data-lucide="palette" class="h-4 w-4"></i> Stüdyoda Tasarla
                                </a>
                            }
                            <button onclick='@(isEnded || isVoting ? $"viewResults({comp.Id}, \"{System.Web.HttpUtility.JavaScriptStringEncode(comp.Title ?? "")}\", \"{comp.Status}\")" : $"joinCompetition({comp.Id}, \"{System.Web.HttpUtility.JavaScriptStringEncode(comp.Theme ?? "")} - {System.Web.HttpUtility.JavaScriptStringEncode(comp.Title ?? "")}\")")' class="w-full rounded-xl py-3 text-sm font-bold transition-all flex items-center justify-center gap-2 @(isVoting ? "bg-accent/10 border border-accent text-accent hover:bg-accent hover:text-accent-foreground pink-glow" : (isEnded ? "bg-secondary text-foreground hover:bg-secondary/80" : "bg-secondary border border-border text-foreground hover:bg-secondary/80"))">
                                @if(isVoting) {
                                    <i data-lucide="check-square" class="h-4 w-4"></i> @("Tasarımları Oyla")
                                } else if(isEnded) {
                                    <i data-lucide="trophy" class="h-4 w-4 text-yellow-500"></i> @("Sonuçları Gör")
                                } else if(joined) {
                                    <i data-lucide="check-circle" class="h-4 w-4"></i> @("Katildin")
                                } else {
                                    <i data-lucide="upload" class="h-4 w-4"></i> @("Hazır Görsel Yükle")
                                }
                            </button>
                        </div>
                    </div>
                </div>
            }
        }
    </div>

    <!-- Past Winners Section -->
    <div class="mt-16 pt-8 border-t border-border/50">
        <div class="flex items-center justify-between mb-8">
            <h2 class="text-2xl font-bold flex items-center gap-2">
                <i data-lucide="award" class="h-6 w-6 text-primary"></i>
                Haftanin Kazananlari
            </h2>
            <button class="text-sm text-muted-foreground hover:text-primary transition-colors flex items-center gap-1">
                Tumunu Gor <i data-lucide="chevron-right" class="h-4 w-4"></i>
            </button>
        </div>
        
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
            @{
                var winners = ViewBag.RecentWinners as System.Collections.Generic.IEnumerable<dynamic>;
                var hasWinners = winners != null && System.Linq.Enumerable.Any(winners);
            }
            @if (hasWinners)
            {
                foreach (var w in winners)
                {
                    var bitis = (DateTime?)w.OylamaBitisTarihi;
                    string zaman = "yakın zamanda";
                    if (bitis.HasValue)
                    {
                        var fark = DateTime.UtcNow - bitis.Value;
                        if (fark.TotalDays < 1) zaman = "bugün";
                        else if (fark.TotalDays < 2) zaman = "dün";
                        else if (fark.TotalDays < 7) zaman = $"{(int)fark.TotalDays} gun once";
                        else zaman = $"{(int)(fark.TotalDays / 7)} hafta once";
                    }
                    string ad = (string)w.KazananAdi ?? "Anonim";
                    string profilResmi = (string)w.ProfilResmi ?? "/img/default-user.png";
                    string tasarimGorseli = (string)w.TasarimGorseli ?? "/img/default-design.svg";
                    string yarismaBaslik = (string)w.YarismaBaslik ?? "Yarışma";
                    string odul = (string)w.Odul ?? "-";
                    int oySayisi = (int)w.OySayisi;
                    <div class="group glass-card rounded-2xl p-5 hover:border-primary/50 transition-all hover:shadow-lg relative overflow-hidden">
                        <div class="absolute -right-5 -top-5 h-20 w-20 rounded-full bg-primary/10 blur-2xl transition-all group-hover:bg-primary/20"></div>

                        <div class="flex items-center gap-3 mb-4 relative z-10">
                            <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-gradient-to-br from-yellow-400 to-amber-600 shadow-lg shadow-amber-500/20 text-white">
                                <i data-lucide="trophy" class="h-5 w-5"></i>
                            </div>
                            <div class="min-w-0">
                                <p class="font-bold text-sm truncate">@yarismaBaslik</p>
                                <p class="text-xs text-muted-foreground flex items-center gap-1">
                                    <i data-lucide="calendar" class="h-3 w-3"></i> @zaman
                                </p>
                            </div>
                        </div>

                        <div class="rounded-xl overflow-hidden aspect-video relative mb-4 bg-black">
                            <img src="@tasarimGorseli" class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-110" onerror="this.src='/img/default-design.svg'" />
                            <span class="absolute top-2 right-2 rounded-full bg-yellow-500 px-2 py-0.5 text-[10px] font-black text-black shadow-lg">@oySayisi oy</span>
                        </div>

                        <div class="flex items-center justify-between relative z-10">
                            <div class="flex items-center gap-2 min-w-0 flex-1">
                                <img src="@profilResmi" class="h-8 w-8 rounded-full shrink-0 object-cover" onerror="this.src='https://ui-avatars.com/api/?name=@(Uri.EscapeDataString(ad))&background=random'" />
                                <div class="truncate pr-2">
                                    <p class="text-sm font-semibold truncate">@ad</p>
                                </div>
                            </div>
                            <div class="shrink-0 text-right">
                                <p class="text-sm font-bold text-primary">@odul</p>
                            </div>
                        </div>
                    </div>
                }
            }
            else
            {
                <div class="col-span-full rounded-2xl border border-dashed border-border bg-secondary/30 p-10 text-center">
                    <i data-lucide="trophy" class="h-10 w-10 text-muted-foreground mx-auto mb-3"></i>
                    <p class="font-semibold text-muted-foreground">Henüz tamamlanan yarışma yok</p>
                    <p class="text-xs text-muted-foreground mt-1">İlk yarışma bittiğinde kazananlar burada görünecek.</p>
                </div>
            }
        </div>
    </div>
    <!-- Join Competition Modal -->
    <div id="compJoinModal" class="fixed inset-0 z-50 hidden items-center justify-center">
        <div class="absolute inset-0 bg-black/60 backdrop-blur-sm" onclick="closeCompModal()"></div>
        <div class="relative z-10 w-full max-w-lg mx-4 max-h-[90vh] overflow-y-auto rounded-3xl border border-border bg-card p-6 shadow-2xl">
            <div class="absolute -right-20 -top-20 h-40 w-40 rounded-full bg-primary/20 blur-3xl pointer-events-none"></div>
            <div class="relative z-10">
                <div class="flex items-center justify-between mb-6">
                    <h2 class="text-2xl font-bold flex items-center gap-2">
                        <i data-lucide="upload-cloud" class="h-6 w-6 text-primary"></i>
                        Tasarımını Gönder
                    </h2>
                    <button type="button" onclick="closeCompModal()" class="flex h-8 w-8 items-center justify-center rounded-full hover:bg-secondary transition-colors">
                        <i data-lucide="x" class="h-4 w-4"></i>
                    </button>
                </div>

                <form onsubmit="submitCompetitionEntry(event)" enctype="multipart/form-data" class="space-y-4">
                    @Html.AntiForgeryToken()
                    <input type="hidden" id="compIdInput" name="yarismaId" />
                    <div>
                        <label class="text-sm font-medium mb-1.5 block">Yarışma Teması</label>
                        <input type="text" id="compThemeInput" name="baslik" readonly class="w-full rounded-xl border border-border bg-secondary/50 px-4 py-2.5 text-sm font-semibold opacity-80" />
                    </div>

                    <div>
                        <label class="text-sm font-medium mb-1.5 block">Açıklama & Etiketler</label>
                        <textarea name="aciklama" rows="2" class="w-full rounded-xl border border-border bg-background px-4 py-3 text-sm focus:border-primary focus:outline-none resize-none" placeholder="Tasarımın için kısa bir hikaye yaz..."></textarea>
                    </div>

                    <div>
                        <label class="text-sm font-medium mb-1.5 block">Çalışmanı Yükle</label>
                        <div class="rounded-2xl border-2 border-dashed border-border bg-secondary/30 p-8 text-center transition-colors hover:border-primary/50 relative overflow-hidden group">
                            <input type="file" name="tasarim" required accept="image/png,image/jpeg,image/gif,image/webp" class="absolute inset-0 w-full h-full opacity-0 cursor-pointer z-10" />
                            <div class="relative z-0">
                                <div class="mx-auto flex h-12 w-12 items-center justify-center rounded-full bg-background mb-3 shadow-sm">
                                    <i data-lucide="image" class="h-5 w-5 text-muted-foreground group-hover:text-primary transition-colors"></i>
                                </div>
                                <p class="text-sm font-semibold mb-1">Dosya seç veya sürükle</p>
                                <p class="text-xs text-muted-foreground">PNG, JPG veya WEBP (Max 5MB)</p>
                            </div>
                        </div>
                    </div>

                    <button type="submit" class="w-full rounded-xl bg-primary py-3.5 text-sm font-bold text-primary-foreground transition-all hover:opacity-90 neon-glow">
                        Şimdi Katıl!
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function filterComps(filter) {
            var buttons = ['all', 'active', 'voting', 'ended'];
            for (var i = 0; i < buttons.length; i++) {
                var btn = document.getElementById('comp-' + buttons[i]);
                if (!btn) continue;
                if (buttons[i] === filter) {
                    btn.className = 'rounded-xl px-6 py-2.5 text-sm font-bold transition-all bg-primary text-primary-foreground gold-glow';
                } else {
                    btn.className = 'rounded-xl px-6 py-2.5 text-sm font-bold transition-all bg-secondary text-secondary-foreground hover:bg-secondary/80';
                }
            }
            
            var comps = document.querySelectorAll('#competitionsGrid > div');
            comps.forEach(function(comp) {
                var status = comp.getAttribute('data-status');
                if (filter === 'all' || status === filter) {
                    comp.style.display = 'flex';
                } else {
                    comp.style.display = 'none';
                }
            });
            console.log('Competition filter set:', filter);
        }
        
        function csrfToken() {
            return document.querySelector('input[name="__RequestVerificationToken"]')?.value || '';
        }

        function showCompToast(message, error) {
            var toast = document.createElement('div');
            toast.className = 'fixed bottom-4 left-1/2 -translate-x-1/2 z-[80] px-6 py-3 rounded-xl shadow-2xl font-bold text-sm ' + (error ? 'bg-red-600 text-white' : 'bg-primary text-primary-foreground');
            toast.textContent = message;
            document.body.appendChild(toast);
            setTimeout(function() { toast.style.transition = 'opacity .4s'; toast.style.opacity = '0'; setTimeout(function() { toast.remove(); }, 450); }, 2600);
        }

        function escapeHtml(text) {
            var d = document.createElement('div');
            d.textContent = text || '';
            return d.innerHTML;
        }

        function joinCompetition(id, title) {
            document.getElementById('compIdInput').value = id;
            document.getElementById('compThemeInput').value = title;
            var modal = document.getElementById('compJoinModal');
            modal.classList.remove('hidden');
            modal.classList.add('flex');
            document.body.style.overflow = 'hidden';
            if (typeof lucide !== 'undefined') lucide.createIcons();
        }

        function submitCompetitionEntry(event) {
            event.preventDefault();
            var form = event.target;
            var btn = form.querySelector('button[type="submit"]');
            var data = new FormData(form);
            if (btn) { btn.disabled = true; btn.textContent = 'Yükleniyor...'; }

            fetch('/Social/YarismaKatil', {
                method: 'POST',
                headers: { 'RequestVerificationToken': csrfToken() },
                body: data
            }).then(function(r) { return r.json(); }).then(function(data) {
                if (!data.success) {
                    showCompToast(data.message || 'İşlem tamamlandı.', true);
                    return;
                }
                closeCompModal();
                var aiSkor = data.aiSkor != null ? data.aiSkor : (data.AiSkor != null ? data.AiSkor : null);
                var aiYorum = data.aiYorum || data.AiYorum || '';
                if (aiSkor != null && typeof Swal !== 'undefined') {
                    var renk = aiSkor >= 80 ? '#22c55e' : aiSkor >= 60 ? '#facc15' : '#ef4444';
                    Swal.fire({
                        title: 'AI Jüri Puanladı: ' + aiSkor + '/100',
                        html: '<div style="font-size:14px;color:#bbb;line-height:1.5">' + escapeHtml(aiYorum) + '</div>',
                        icon: aiSkor >= 60 ? 'success' : 'info',
                        confirmButtonText: 'Harika!',
                        confirmButtonColor: renk,
                        background: '#0a0a0c',
                        color: '#fff'
                    }).then(function() { window.location.reload(); });
                } else {
                    showCompToast(data.message || 'Tasarım gönderildi.', false);
                    setTimeout(function() { window.location.reload(); }, 1200);
                }
            }).catch(function() {
                showCompToast('Bağlantı hatası oluştu.', true);
            }).finally(function() {
                if (btn) { btn.disabled = false; btn.textContent = 'Şimdi Katıl!'; }
            });
        }

        function closeCompModal() {
            var modal = document.getElementById('compJoinModal');
            modal.classList.add('hidden');
            modal.classList.remove('flex');
            document.body.style.overflow = '';
        }

        function viewResults(id, title, status) {
            var modal = document.getElementById('resultsModal');
            modal.classList.remove('hidden');
            modal.classList.add('flex');
            document.body.style.overflow = 'hidden';
            var titleEl = document.getElementById('resultsTitle');
            if (titleEl) titleEl.textContent = title || 'Yarışma Sonuçları';
            loadCompetitionEntries(id, status || 'ended');
            if (typeof lucide !== 'undefined') lucide.createIcons();
            if (typeof confetti === 'function') {
                confetti({ particleCount: 100, spread: 70, origin: { y: 0.6 } });
            }
        }

        function loadCompetitionEntries(id, status) {
            var wrap = document.getElementById('resultsEntries');
            if (!wrap) return;
            wrap.innerHTML = '<div class="py-10 text-center text-muted-foreground">Tasarımlar yükleniyor...</div>';
            fetch('/Social/YarismaKatilimlari?yarismaId=' + encodeURIComponent(id))
                .then(function(r) { return r.json(); })
                .then(function(data) {
                    if (!data.success || !data.entries || data.entries.length === 0) {
                        wrap.innerHTML = '<div class="rounded-2xl border border-border bg-secondary/40 p-8 text-center text-muted-foreground">Bu yarışmada henüz tasarım yok.</div>';
                        return;
                    }
                    wrap.innerHTML = data.entries.map(function(e, index) {
                        var canVote = status === 'voting';
                        var entryId = e.Id || e.id;
                        var aiSkor = e.AiSkor != null ? e.AiSkor : (e.aiSkor != null ? e.aiSkor : null);
                        var aiYorum = e.AiYorum || e.aiYorum || '';
                        var aiSaglayici = e.AiSaglayici || e.aiSaglayici || 'AI';
                        var aiColor = aiSkor == null ? 'bg-secondary text-muted-foreground'
                            : (aiSkor >= 80 ? 'bg-green-500/20 text-green-300 border border-green-500/40'
                            : aiSkor >= 60 ? 'bg-yellow-500/20 text-yellow-300 border border-yellow-500/40'
                            : 'bg-red-500/20 text-red-300 border border-red-500/40');
                        var aiBadge = '<span class="rounded-full px-3 py-1 text-xs font-bold ' + aiColor + '" title="' + escapeHtml(aiSaglayici) + ' jüri puanı">' +
                            '<i data-lucide="sparkles" class="h-3 w-3 inline-block mr-1"></i>' +
                            (aiSkor == null ? 'AI: -' : 'AI: ' + aiSkor + '/100') + '</span>';
                        var aiYorumHtml = aiYorum
                            ? '<div class="mt-2 text-xs text-muted-foreground italic border-l-2 border-primary/40 pl-3">' +
                              '<span class="font-semibold text-primary not-italic">AI Jüri:</span> ' + escapeHtml(aiYorum) + '</div>'
                            : '';
                        return '<div class="rounded-2xl border border-border bg-secondary/30 overflow-hidden">' +
                            '<div class="aspect-video bg-black"><img src="' + (e.GorselUrl || e.gorselUrl) + '" class="h-full w-full object-cover" /></div>' +
                            '<div class="p-4 space-y-3"><div class="flex items-center justify-between gap-3">' +
                            '<div><p class="font-bold">' + escapeHtml(e.Baslik || e.baslik || 'Tasarım') + '</p><p class="text-xs text-muted-foreground">' + escapeHtml(e.KullaniciAdi || e.kullaniciAdi || '') + '</p></div>' +
                            '<div class="flex flex-col items-end gap-1.5">' +
                            '<span class="rounded-full bg-primary/15 px-3 py-1 text-xs font-bold text-primary" id="entry-votes-' + entryId + '">' + (e.OySayisi || e.oySayisi || 0) + ' oy</span>' +
                            aiBadge + '</div></div>' +
                            aiYorumHtml +
                            (canVote ? '<button onclick="voteCompetition(' + id + ',' + entryId + ')" class="w-full rounded-xl bg-accent px-4 py-2.5 text-sm font-bold text-accent-foreground">Oy Ver</button>' : '<div class="text-xs text-muted-foreground">Siralama #' + (index + 1) + '</div>') +
                            '</div></div>';
                    }).join('');
                    if (typeof lucide !== 'undefined') lucide.createIcons();
                });
        }

        function voteCompetition(yarismaId, katilimId) {
            var body = new URLSearchParams();
            body.append('yarismaId', yarismaId);
            body.append('katilimId', katilimId);
            fetch('/Social/YarismaOyVer', {
                method: 'POST',
                headers: { 'Content-Type': 'application/x-www-form-urlencoded; charset=UTF-8', 'RequestVerificationToken': csrfToken() },
                body: body.toString()
            }).then(function(r) { return r.json(); }).then(function(data) {
                showCompToast(data.message || 'Oyun kaydedildi.', !data.success);
                if (data.success) {
                    var el = document.getElementById('entry-votes-' + katilimId);
                    if (el) el.textContent = data.votes + ' oy';
                }
            }).catch(function() { showCompToast('Oy verilemedi.', true); });
        }

        function closeResultsModal() {
            var modal = document.getElementById('resultsModal');
            modal.classList.add('hidden');
            modal.classList.remove('flex');
            document.body.style.overflow = '';
        }

        document.addEventListener('keydown', function(e) {
            if (e.key === 'Escape') {
                var comp = document.getElementById('compJoinModal');
                if (comp && !comp.classList.contains('hidden')) closeCompModal();
                var res = document.getElementById('resultsModal');
                if (res && !res.classList.contains('hidden')) closeResultsModal();
            }
        });
    </script>
    <!-- Add Confetti JS for WOW effect -->
    <script src="https://cdn.jsdelivr.net/npm/canvas-confetti@1.6.0/dist/confetti.browser.min.js"></script>
    <!-- SweetAlert2 for AI Jury verdict modal -->
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
}

